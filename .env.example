# ============================================================================
# SIKANDER AI — corpus service configuration
# Copy to .env. Blank values are firm decisions: the dashboard shows them as NOT CONFIGURED
# and the service uses its most conservative behaviour until they are set.
# NEVER commit .env. NEVER paste a credential into a prompt, a ticket or a chat.
# ============================================================================

# ---- deployment --------------------------------------------------------------
APP_ENV=production
# 'chambers' means the firm's own trusted host, wherever it is located: the chambers PC or a cloud
# server the firm controls. Login-session scraping runs only there, and login-session content never
# leaves it. Any other value refuses ALLOW_LOGIN_SCRAPING=true.
ENVIRONMENT=chambers
ALLOW_LOGIN_SCRAPING=false
# Cloud overlay (cloud/install.sh sets these): bind the API to localhost so only Caddy reaches it,
# and include the HTTPS overlay in every `docker compose` command.
API_BIND=0.0.0.0
#COMPOSE_FILE=docker-compose.yml:docker-compose.cloud.yml
#DASHBOARD_DOMAIN=
DEPLOY_REGION=
DATA_RESIDENCY_NOTE=
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi
DEBUG=false

# ---- database / roles --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://legal:legal@postgres:5432/legal_scraper
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal
POSTGRES_DB=legal_scraper
# Read-only role handed to SIKANDER AI (SELECT on contract tables only). Blank = not created.
SIKANDER_READER_ROLE=sikander_reader
SIKANDER_READER_PASSWORD=
CORPUS_WRITER_ROLE=corpus_writer
CORPUS_WRITER_PASSWORD=

# ---- redis / celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Dedicated promote worker (docker compose service worker-promote). When false, promotion stays on maintenance.
#SSA_PROMOTE_DEDICATED_QUEUE_ENABLED=true
#CELERY_PROMOTE_CONCURRENCY=1
# Alert when promoted_at is stale while extracted staging rows wait (Beat task promotion-stale-alert).
#PROMOTION_STALE_ALERT_ENABLED=true
#PROMOTION_STALE_PROMOTION_MINUTES=15
#PROMOTION_STALE_EXTRACTED_MIN_AGE_MINUTES=10
# classify_treatment soft wall-clock limit (seconds); partial commits are kept.
#CLASSIFY_TREATMENT_SOFT_TIME_LIMIT=240
#CLASSIFY_TREATMENT_BATCH=200

# ---- secrets (required) ------------------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# openssl rand -hex 32
ADMIN_API_KEY=
# Read-only corpus API (/corpus/v1) for the legal research agent; sent as X-Corpus-Key. Not the admin key.
# Blank = the API answers 503. Needs SIKANDER_READER_PASSWORD set (it reads as that role).
CORPUS_API_KEY=
SECRET_KEY=

# ---- embeddings (Annex B-6) --------------------------------------------------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=50
EMBEDDING_RPM_LIMIT=100
EMBED_LOGIN_SESSION_ROWS_EXTERNALLY=false

# ---- scraper -----------------------------------------------------------------
SCRAPER_DELAY_MIN=1.2
SCRAPER_DELAY_MAX=2.5
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_BACKOFF=2.0
SCRAPER_RESPECT_ROBOTS=true
# Statute safety (B3): all three rules are ON when unset. Set to 0 or false only to disable legacy behaviour.
# SSA_STATUTE_NO_MENTION_STUBS=0
# SSA_STATUTE_PDF_FOLLOW=0
# SSA_STATUTE_NAME_QUALITY=0
# Statute quality CLI / ingest (off by default; enable per pass):
# SSA_STATUTE_QUALITY_DEDUPE=1
# SSA_STATUTE_QUALITY_JURISDICTION=1
# SSA_STATUTE_QUALITY_ASSEMBLY_PARSER=1
# SSA_STATUTE_QUALITY_SECTION_FILTER=1
# SSA_STATUTE_QUALITY_OCR_GATE=1
# SSA_STATUTE_QUALITY_GAZETTE_HEADER=1
# SSA_STATUTE_QUALITY_REQUARANTINE=1
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_EXECUTABLE_PATH=
PLAYWRIGHT_MAX_HTML_BYTES=2000000
PLAYWRIGHT_OVERSIZE_INPUT_THRESHOLD=500

# ---- PakistanLawSite (login_session; human login only) -----------------------
RECONNECT_SECONDS=30
LOGIN_DELAY_MIN=4
LOGIN_DELAY_MAX=9
PAGES_PER_HOUR=300
PAGES_PER_DAY=2500
VOLUME_END_GAP=40
SEARCH_MAP_STALE_FAILURES=5
# Login-session workers (1 or 2). With two ACTIVE slots and 2, reporter shards run in parallel.
LOGIN_SESSION_CONCURRENCY=2
# What this server harvests: all (one server does everything), pls (PakistanLawSite only) or
# public (the free sites only). Two servers, one per role. See docs/TWO_SERVERS.md.
DEPLOY_ROLE=all
HARVEST_MODE=updates
HARVEST_AUTO_SWITCH=true
UPDATE_CADENCE_HOURS=6
BACKFILL_SOURCE_FREQUENCY_MINUTES=15
BACKFILL_LOGIN_DELAY_MIN=6
BACKFILL_LOGIN_DELAY_MAX=9
BACKFILL_PAGES_PER_HOUR=450
BACKFILL_PAGES_PER_DAY=200000
BACKFILL_LOGIN_SESSION_CONCURRENCY=2
DISPATCH_LOOP_SECONDS=60
PLAYWRIGHT_MAX_HTML_BYTES=2000000
PLAYWRIGHT_OVERSIZE_INPUT_THRESHOLD=5000
PLS_ARCHIVED_GRID_MAX_ROWS=400
PLS_ARCHIVED_GRID_SNAPSHOT_TIMEOUT_SECONDS=20
PLS_CITATION_GRID_MAX_DETAIL=120
PLS_CITATION_GRID_SCAN_WINDOW=200
BACKFILL_PLS_CITATION_GRID_MAX_DETAIL=300
BACKFILL_PLS_CITATION_GRID_SCAN_WINDOW=600
PLS_RUN_MAX_MINUTES=0
BACKFILL_PLS_RUN_MAX_MINUTES=50
PLS_CITATION_GRID_SKIP_STAGED=true
PLS_KEEPALIVE_SCHEDULE_SECONDS=3600
PLS_STALL_WATCHDOG_SECONDS=1800
# PLS_STALL_NO_PROMOTION_MINUTES_WHEN_ACTIVE=30
# PLS_STALL_WATCHDOG_SIGNATURE_MINUTES=30
# Watchdog: a PakistanLawSite browser operation with no progress this long is a frozen browser; it is
# restarted on the same login slot and resumes from the same cursor (0 disables).
PLS_BROWSER_OP_TIMEOUT_SECONDS=180
PLS_GRID_OP_TIMEOUT_SECONDS=600
# Operator decision of 24 September 2026: a lost slot is re-verified after the cool-down and, if
# dead, signed in again with the username/password saved for it on the dashboard (Human login tab).
LOGIN_AUTO_RECOVER=true
LOGIN_RECOVERY_COOLDOWN_MINUTES=3
LOGIN_RECOVERY_SCHEDULE_SECONDS=60
# Every 30 minutes a few promoted records are re-fetched from their source and compared with the
# corpus; results on /status (operator request of 24 September 2026).
SPOT_CHECK_SCHEDULE_SECONDS=1800
SPOT_CHECK_JUDGMENTS=3
SPOT_CHECK_STATUTES=2
MIRROR_LOGIN_SESSION_ROWS=false
# Parallel Google Drive uploads per mirror run (1 = one file at a time).
MIRROR_DRIVE_CONCURRENCY=1
EXPORT_LOGIN_SESSION_FULL_TEXT=false
PLS_BASE_URL=https://www.pakistanlawsite.com
PLS_LOGIN_URL=https://www.pakistanlawsite.com/
PLS_SEARCH_URL=https://www.pakistanlawsite.com/Login/CitationSearch
# Seconds to wait for the "Case Description" control on a ReferenceCaseLawSearch page before calling it headnote-only.
PLS_CASE_DESCRIPTION_WAIT_SECONDS=6
PLS_ARCHIVED_GRID_MAX_ROWS=400
PLS_ARCHIVED_GRID_SNAPSHOT_TIMEOUT_SECONDS=20
PLS_CITATION_GRID_MAX_DETAIL=120
PLS_CITATION_GRID_SCAN_WINDOW=200
PLS_CITATION_GRID_SKIP_STAGED=true
PLS_RUN_MAX_MINUTES=0
# Firm values (subscribed reporters, earliest year, Tier 3 vocabulary): blank = NOT CONFIGURED.
PLS_SUBSCRIBED_REPORTERS=
# Per-journal citation grid: select each journal in the site's citation-search form and walk its grid with
# its own cursor (blank journals list = PLS_SUBSCRIBED_REPORTERS). Falls back to the default grid when the
# form offers no journal dropdown or ignores the choice.
PLS_GRID_JOURNAL_ROTATION=true
PLS_GRID_JOURNALS=
PLS_GRID_JOURNAL_MIN_MATCH=0.5
PLS_EARLIEST_YEAR=
PLS_TIER3_VOCABULARY=
# Search-driven gap harvest (one CitationSearch query per Beat tick when enabled).
# Walk judgments by the site's own case serial (year + court letter + serial); see scraper/pls_caseid.py.
PLS_CASEID_WALK_ENABLED=true
PLS_CASEID_WALK_SCHEDULE_SECONDS=600
PLS_CASEID_WALK_PROBES_PER_TICK=60
PLS_SEARCH_HARVEST_ENABLED=0
PLS_SEARCH_HARVEST_SCHEDULE_SECONDS=3600
# login 1's reporter share of the search-harvest ledger; login 2 harvests every other reporter (handbook R3.1)
PLS_SEARCH_HARVEST_SLOT1_REPORTERS=PLD,SCMR,CLC,YLR,CLD,GBLR
PLS_SEARCH_HARVEST_TAKEOVER_MINUTES=30
PLS_SEARCH_HARVEST_CONTINUE=1
# Orphan search-harvest Redis locks after worker-scraper recreate (default off; see docs/PLS_HARVEST_HANDBOOK.md)
# PLS_LOCK_HOLDER_IDENTITY=1
# PLS_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
# PLS_LOCK_DEAD_HOLDER_TAKEOVER=1
# PLS_LOCK_RELEASE_ON_WORKER_SHUTDOWN=1
# PLS_DEPLOY_RELEASE_SEARCH_HARVEST_LOCKS=1
# PLS_STALL_LOCK_HELD_NO_STAGING_ENABLED=1
# PLS_STALL_LOCK_HELD_NO_STAGING_MINUTES=15
PLS_SEARCH_RESULT_CAP=500
# PLS hardening layers (default on). Set =0 to disable. See docs/HARDENING_LAYERS.md.
# SSA_ORDER_SHEET_TITLE=0
# SSA_ENCODING_GUARD=0
# SSA_COURT_HEADER_GUARD=0
# SSA_PLD_CITATION_RELABEL=0
# SSA_SHORT_TEXT_GUARD=0
# SSA_HARVEST_PG_LOCK=0
# SSA_DOCUMENT_SAVE_VALIDATION=0

PLS_SEARCH_HARVEST_MAX_PAGES_PER_QUERY=0
PLS_BROWSER_RECYCLE_WINDOWS=12
PLS_BROWSER_RSS_LIMIT_MB=900
PLS_BROWSER_RSS_HARD_MB=1200
PLS_BLOCK_HEAVY_RESOURCES=true
# Legacy automated-login names are accepted but IGNORED (human login only). Leave blank.
PLS_USER=
PLS_PASS=
PLS_USER_B=
PLS_PASS_B=

# ---- storage -----------------------------------------------------------------
PDF_STORAGE_PATH=/app/live
RAW_STORAGE_PATH=/app/raw
STATE_STORAGE_PATH=/app/state
PDF_MAX_SIZE_MB=100
OCR_ENABLED=true
OCR_LANGUAGE=eng

# ---- archive mirror (Section 9A) — targets can also be added on the dashboard ----
ARCHIVE_ENABLED=true
ARCHIVE_LOCAL_PATH=
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
ARCHIVE_S3_REGION=
ARCHIVE_SFTP_HOST=
ARCHIVE_SFTP_PORT=22
ARCHIVE_SFTP_USER=
ARCHIVE_SFTP_PASSWORD=
ARCHIVE_SFTP_ROOT=
ARCHIVE_SMB_SERVER=
ARCHIVE_SMB_SHARE=
ARCHIVE_SMB_USER=
ARCHIVE_SMB_PASSWORD=
ARCHIVE_SMB_ROOT=
ARCHIVE_DROPBOX_TOKEN=
ARCHIVE_DROPBOX_ROOT=
ARCHIVE_ONEDRIVE_TOKEN=
ARCHIVE_ONEDRIVE_ROOT=
# Batch transfer: Google Drive receives judgments in batches of about this many bytes (1 GB), or once
# the oldest waiting judgment has waited ARCHIVE_BATCH_MAX_WAIT_HOURS. 0 = copy every record as promoted.
ARCHIVE_BATCH_BYTES=1073741824
ARCHIVE_BATCH_MAX_WAIT_HOURS=24
ARCHIVE_BATCH_TARGET_TYPES=google_drive
GOOGLE_DRIVE_ENABLED=false
DRIVE_FOLDER_ROOT=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ---- treatment classification (Annex B-7) ------------------------------------
TREATMENT_MODEL=
TREATMENT_MIN_CONFIDENCE=0.7
LOCAL_TREATMENT_BASE_URL=
LOCAL_TREATMENT_MODEL=
LOCAL_TREATMENT_API_KEY=

# ---- reading agent for unreported judgments (docs/UNREPORTED_JUDGMENTS.md) ----
# Blank = off (falls back to TREATMENT_MODEL). Uses OPENAI_API_KEY unless READER_API_KEY/READER_BASE_URL are set.
READER_MODEL=
READER_BASE_URL=
READER_API_KEY=

# ---- ScrapeGraphAI (Amendment D-15 §15) --------------------------------------
SGAI_ENABLED=true
SGAI_MODE=hybrid
SGAI_API_KEY=
SGAI_MANAGED_PUBLIC_ONLY=true
SGAI_LOCAL_ENABLED=true
SGAI_LOCAL_LLM_PROVIDER=ollama
SGAI_LOCAL_LLM_MODEL=
SGAI_LOCAL_LLM_BASE_URL=
SGAI_LOCAL_TRUSTED_HOSTS=
SGAI_TIMEOUT_SECONDS=120
SGAI_MAX_RETRIES=2
SGAI_DAILY_CREDIT_CAP=
SGAI_CACHE_ENABLED=true
SGAI_SCHEMA_VERSION=1
SGAI_STEALTH_ALLOWED=false
SGAI_FAIL_OPEN_TO_DETERMINISTIC=true
SGAI_CIRCUIT_BREAKER_FAILURES=5
SGAI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=900
SGAI_PUBLIC_TEST_URL=
SGAI_DEFAULT_MIN_CONFIDENCE=0.85
