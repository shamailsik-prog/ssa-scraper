# ============================================================================
# SIKANDER AI — corpus service configuration
# Copy to .env. Blank values are firm decisions: the dashboard shows them as NOT CONFIGURED
# and the service uses its most conservative behaviour until they are set.
# NEVER commit .env. NEVER paste a credential into a prompt, a ticket or a chat.
# ============================================================================

# ---- deployment --------------------------------------------------------------
APP_ENV=production
# 'chambers' means the firm's own trusted host, wherever it is located: the chambers PC or a cloud
# server the firm controls. Login-session scraping runs only there, and login-session content never
# leaves it. Any other value refuses ALLOW_LOGIN_SCRAPING=true.
ENVIRONMENT=chambers
ALLOW_LOGIN_SCRAPING=false
# Cloud overlay (cloud/install.sh sets these): bind the API to localhost so only Caddy reaches it,
# and include the HTTPS overlay in every `docker compose` command.
API_BIND=0.0.0.0
#COMPOSE_FILE=docker-compose.yml:docker-compose.cloud.yml
#DASHBOARD_DOMAIN=
DEPLOY_REGION=
DATA_RESIDENCY_NOTE=
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi
DEBUG=false

# ---- database / roles --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://legal:legal@postgres:5432/legal_scraper
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal
POSTGRES_DB=legal_scraper
# Read-only role handed to SIKANDER AI (SELECT on contract tables only). Blank = not created.
SIKANDER_READER_ROLE=sikander_reader
SIKANDER_READER_PASSWORD=
CORPUS_WRITER_ROLE=corpus_writer
CORPUS_WRITER_PASSWORD=

# ---- redis / celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
DISPATCH_LOOP_SECONDS=60

# ---- secrets (required) ------------------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# openssl rand -hex 32
ADMIN_API_KEY=
SECRET_KEY=

# ---- embeddings (Annex B-6) --------------------------------------------------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=50
EMBEDDING_RPM_LIMIT=100
EMBED_LOGIN_SESSION_ROWS_EXTERNALLY=false

# ---- scraper -----------------------------------------------------------------
SCRAPER_DELAY_MIN=1.2
SCRAPER_DELAY_MAX=2.5
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_BACKOFF=2.0
SCRAPER_RESPECT_ROBOTS=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=90000
PLAYWRIGHT_EXECUTABLE_PATH=

# ---- PakistanLawSite (login_session; human login only) -----------------------
RECONNECT_SECONDS=30
LOGIN_DELAY_MIN=4
LOGIN_DELAY_MAX=9
PAGES_PER_HOUR=300
PAGES_PER_DAY=2500
# Global runtime mode. Backfill mode is continuous/high-throughput; updates mode is periodic.
HARVEST_MODE=backfill
HARVEST_AUTO_SWITCH=true
# Steady-state cadence after backfill completes.
UPDATE_CADENCE_HOURS=6
# Backfill cadence and completion targets. Auto-switch to updates mode happens ONLY when a target
# is set here and reached with the frontier drained; with both at 0 the service stays in backfill
# until you switch it from the dashboard.
BACKFILL_SOURCE_FREQUENCY_MINUTES=15
BACKFILL_TARGET_JUDGMENTS=0
BACKFILL_TARGET_STATUTES=0
# Backfill pacing profile (used only while HARVEST_MODE=backfill).
# PakistanLawSite ends a login after roughly 500-600 page views in an hour; 6-9s between fetches keeps
# the account near 380 pages/hour and the 450/hour budget pauses the run before the site does.
BACKFILL_LOGIN_DELAY_MIN=6
BACKFILL_LOGIN_DELAY_MAX=9
BACKFILL_PAGES_PER_HOUR=450
BACKFILL_PAGES_PER_DAY=200000
BACKFILL_LOGIN_SESSION_CONCURRENCY=2
# Public-source explicit-block retry defaults (opt-in per source from dashboard controls).
BLOCK_RETRY_COOLDOWN_MINUTES=120
BLOCK_RETRY_MAX_ATTEMPTS=3
VOLUME_END_GAP=40
SEARCH_MAP_STALE_FAILURES=5
LOGIN_SESSION_CONCURRENCY=1
MIRROR_LOGIN_SESSION_ROWS=false
EXPORT_LOGIN_SESSION_FULL_TEXT=false
PLS_BASE_URL=https://www.pakistanlawsite.com
PLS_LOGIN_URL=https://www.pakistanlawsite.com/
PLS_SEARCH_URL=https://www.pakistanlawsite.com/Login/CitationSearch
# Rows materialized per compact #archivedpatientGrid snapshot (one window); halved automatically on a snapshot timeout.
PLS_ARCHIVED_GRID_MAX_ROWS=400
# Detail pages fetched per citation-grid window (updates mode / backfill mode).
PLS_CITATION_GRID_MAX_DETAIL=120
BACKFILL_PLS_CITATION_GRID_MAX_DETAIL=300
# Rows scanned per window (known rows are skipped without a fetch).
PLS_CITATION_GRID_SCAN_WINDOW=200
BACKFILL_PLS_CITATION_GRID_SCAN_WINDOW=600
# Keep taking consecutive windows inside one login_session job for this many minutes (0 = one window per job).
# Backfill: the session stays busy for the whole job instead of idling until the next Beat kick.
PLS_RUN_MAX_MINUTES=0
BACKFILL_PLS_RUN_MAX_MINUTES=50
# Do not re-download pages whose citation already has a staging row (promoted, pending or in review).
PLS_CITATION_GRID_SKIP_STAGED=true
# Seconds to wait for the "Case Description" control on a ReferenceCaseLawSearch page before calling it headnote-only.
PLS_CASE_DESCRIPTION_WAIT_SECONDS=6
# Firm values (subscribed reporters, earliest year, Tier 3 vocabulary): blank = NOT CONFIGURED.
PLS_SUBSCRIBED_REPORTERS=
PLS_EARLIEST_YEAR=
PLS_TIER3_VOCABULARY=
# Legacy automated-login names are accepted but IGNORED (human login only). Leave blank.
PLS_USER=
PLS_PASS=
PLS_USER_B=
PLS_PASS_B=

# ---- storage -----------------------------------------------------------------
PDF_STORAGE_PATH=/app/live
RAW_STORAGE_PATH=/app/raw
STATE_STORAGE_PATH=/app/state
PDF_MAX_SIZE_MB=100
OCR_ENABLED=true
OCR_LANGUAGE=eng

# ---- archive mirror (Section 9A) — targets can also be added on the dashboard ----
ARCHIVE_ENABLED=true
ARCHIVE_LOCAL_PATH=
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
ARCHIVE_S3_REGION=
ARCHIVE_SFTP_HOST=
ARCHIVE_SFTP_PORT=22
ARCHIVE_SFTP_USER=
ARCHIVE_SFTP_PASSWORD=
ARCHIVE_SFTP_ROOT=
ARCHIVE_SMB_SERVER=
ARCHIVE_SMB_SHARE=
ARCHIVE_SMB_USER=
ARCHIVE_SMB_PASSWORD=
ARCHIVE_SMB_ROOT=
ARCHIVE_DROPBOX_TOKEN=
ARCHIVE_DROPBOX_ROOT=
ARCHIVE_ONEDRIVE_TOKEN=
ARCHIVE_ONEDRIVE_ROOT=
GOOGLE_DRIVE_ENABLED=false
DRIVE_FOLDER_ROOT=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ---- treatment classification (Annex B-7) ------------------------------------
TREATMENT_MODEL=
TREATMENT_MIN_CONFIDENCE=0.7
LOCAL_TREATMENT_BASE_URL=
LOCAL_TREATMENT_MODEL=
LOCAL_TREATMENT_API_KEY=

# ---- ScrapeGraphAI (Amendment D-15 §15) --------------------------------------
SGAI_ENABLED=true
SGAI_MODE=hybrid
SGAI_API_KEY=
SGAI_MANAGED_PUBLIC_ONLY=true
SGAI_LOCAL_ENABLED=true
SGAI_LOCAL_LLM_PROVIDER=ollama
SGAI_LOCAL_LLM_MODEL=
SGAI_LOCAL_LLM_BASE_URL=
SGAI_LOCAL_TRUSTED_HOSTS=
SGAI_TIMEOUT_SECONDS=120
SGAI_MAX_RETRIES=2
SGAI_DAILY_CREDIT_CAP=
SGAI_CACHE_ENABLED=true
SGAI_SCHEMA_VERSION=1
SGAI_STEALTH_ALLOWED=false
SGAI_FAIL_OPEN_TO_DETERMINISTIC=true
SGAI_CIRCUIT_BREAKER_FAILURES=5
SGAI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=900
SGAI_PUBLIC_TEST_URL=
SGAI_DEFAULT_MIN_CONFIDENCE=0.85
