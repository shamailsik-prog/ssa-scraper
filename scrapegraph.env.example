# ScrapeGraphAI integration settings — TEMPLATE ONLY
# Never commit real API keys or passwords.

SGAI_ENABLED=true
SGAI_MODE=hybrid
SGAI_API_KEY=
SGAI_MANAGED_PUBLIC_ONLY=true
SGAI_LOCAL_ENABLED=true
SGAI_LOCAL_LLM_PROVIDER=ollama
SGAI_LOCAL_LLM_MODEL=
SGAI_LOCAL_LLM_BASE_URL=
SGAI_TIMEOUT_SECONDS=120
SGAI_MAX_RETRIES=2
SGAI_DAILY_CREDIT_CAP=
SGAI_CACHE_ENABLED=true
SGAI_SCHEMA_VERSION=1
SGAI_STEALTH_ALLOWED=false
SGAI_FAIL_OPEN_TO_DETERMINISTIC=true

# Existing authenticated-source guards retained by the corpus service.
ENVIRONMENT=chambers
ALLOW_LOGIN_SCRAPING=true
LOGIN_DELAY_MIN=4
LOGIN_DELAY_MAX=9
PAGES_PER_HOUR=300
PAGES_PER_DAY=2500
# Backfill / updates scheduling
HARVEST_MODE=backfill
HARVEST_AUTO_SWITCH=true
UPDATE_CADENCE_HOURS=6
BACKFILL_SOURCE_FREQUENCY_MINUTES=15
BACKFILL_LOGIN_DELAY_MIN=0.4
BACKFILL_LOGIN_DELAY_MAX=1.0
BACKFILL_PAGES_PER_HOUR=10000
BACKFILL_PAGES_PER_DAY=200000
BACKFILL_LOGIN_SESSION_CONCURRENCY=2
RECONNECT_SECONDS=30
VOLUME_END_GAP=40
MIRROR_LOGIN_SESSION_ROWS=false
